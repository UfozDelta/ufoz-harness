# Optional env config for the harness. Copy to `.harness/.env` and uncomment what
# you want to change. A real env var set in your shell always wins over the file.
# Every line is commented out, so copying this file as-is changes nothing.

# --- planner ---
# Planner backend for `--plan`: pi, opencode, claude, cline or cline-acp.
# HARNESS_PLANNER=pi
# Model for the planner backend. Unset falls back to the backend's own default.
# HARNESS_PLANNER_MODEL=

# --- model selection ---
# Executor model for pi, opencode and cline.
# HARNESS_MODEL=opencode/space-bunny-free
# Model for the cline-acp executor. Unset uses its DEFAULT_MODEL
# (stealth/space-bunny-alpha).
# CLINE_MODEL=
# Reasoning effort for every executor (pi --thinking, opencode variant, claude --effort).
# HARNESS_VARIANT=medium

# --- llama executor ---
# URL of your `llama-server` router. Unset defaults to http://127.0.0.1:8080.
# HARNESS_LLAMA_URL=
# Model id to load on that server. Unset uses the only model the server serves.
# HARNESS_LLAMA_MODEL=

# --- cline / pi paths ---
# Path to pi. Unset falls back to ~/.pi/agent/bin/pi-launcher.js.
# HARNESS_PI=
# Path to the cline binary. Unset falls back to `cline` on PATH.
# HARNESS_CLINE=
# cline data dir. Unset falls back to ~/.cline/data.
# HARNESS_CLINE_DATA=
# cline provider id passed to cline-acp. Unset uses cline-acp's own default.
# HARNESS_CLINE_PROVIDER=

# --- run isolation ---
# A real run gets its own worktree and a live window by default. Opt out globally here.
# HARNESS_WORKTREE=0
# HARNESS_WINDOW=0

# --- bench only ---
# Extra flags appended to run_plan.py by the bench scripts. Empty by default.
# HARNESS_RUNNER_FLAGS=
# Cosmetic label for the bench arm, written into the results csv. Unset by default.
# HARNESS_ARM_LABEL=
